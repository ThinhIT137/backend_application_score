# Pooled URL dùng lúc runtime (Supabase / PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# DIRECT_URL chỉ dùng cho migration Prisma — service này không chạy migration
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

JWT_SECRET=thay-bang-secret-dung-chung-voi-auth-service
JWT_ALGORITHM=HS256
JWT_AUDIENCE=

# Giá trị mock khi chưa có API Bộ GD&ĐT / ĐHQG
THPT_PROVIDER=mock
DGNL_PROVIDER=mock

# Email notification
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true