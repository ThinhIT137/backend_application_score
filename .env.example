# Pooled URL dùng lúc runtime (Supabase / PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# DIRECT_URL chỉ dùng cho migration Prisma — service này không chạy migration
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

JWT_SECRET=thay-bang-secret-dung-chung-voi-auth-service
JWT_ALGORITHM=HS256
JWT_AUDIENCE=

# Chỉ bật http khi đã có nguồn đối soát thật; không tạo điểm giả mặc định.
THPT_PROVIDER=disabled
DGNL_PROVIDER=disabled
THPT_API_URL=
THPT_API_TOKEN=
DGNL_API_URL=
DGNL_API_TOKEN=

# Email notification
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional SMS gateway: HTTPS endpoint accepting {"to":"...","message":"..."}.
# Used only for activation OTP sent to the phone already stored on ThiSinh.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
